# Copy to .env for local development only (.env is git-ignored). Values already present in the
# environment always take precedence, so the evaluator's exported AI_API_KEY is never overridden.
AI_API_KEY=
# Optional overrides of profiles/default.toml (leave empty to use the committed configuration):
AI_MODEL=
AI_BASE_URL=
# Optional: raises the GitHub API limit when fetching issues (never exposed to model commands).
GITHUB_TOKEN=
