{
 "task_id": "g-rs-duration",
 "partition": "gauntlet",
 "kind": "regression",
 "language": "rust",
 "limits": {
  "time_limit_s": 900,
  "max_steps": 40
 },
 "judge": {
  "files": {
   "hidden/judge.rs": "tests/judge.rs"
  },
  "cmd": "cargo test --offline -q --test judge"
 },
 "scripted": {
  "edits": [
   {
    "path": "src/lib.rs",
    "old_str": "            'm' => n * 3600,\n",
    "new_str": "            'm' => n * 60,\n"
   }
  ],
  "test": "cargo test --offline"
 }
}
